{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/fastapi-backend",
      "env": {
        "ELASTICSEARCH_HOST": "http://localhost:9200",
        "OLLAMA_HOST": "http://localhost:11434"
      },
      "jinja": true
    },
    {
      "name": "Python Debugger: Remote Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/fastapi-backend",
          "remoteRoot": "/app"
        }
      ]
    }
  ]
}
